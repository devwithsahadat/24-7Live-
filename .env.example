# ==========================================
# 24/7 YouTube Live Streaming Bot Config
# ==========================================

# Telegram Bot Token (Get it from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Admin ID (Optional: Your Telegram User ID from @userinfobot to protect the bot. Leave blank to allow anyone)
TELEGRAM_ADMIN_ID=

# YouTube Live Stream Key (Get it from YouTube Studio -> Go Live -> Stream Key)
YOUTUBE_STREAM_KEY=your_youtube_stream_key_here

# Default Streaming Quality Settings
VIDEO_BITRATE=3000k
AUDIO_BITRATE=128k
FPS=30
PRESET=veryfast
